{
  // Node sharing proof (W25-1).
  // owner, a, and b are the nodes of the owner. g and g2 are the nodes of guest user bob.
  // The owner shares TCP 8080 on node b with bob. Node b also serves TCP 9090. That port is not shared.
  // The acl a -> g does not cross the tenant, so it gives node a nothing on node g.
  "owners": ["spiffe://orblx.local/node/owner"],
  "guests": ["oidc:bob"],
  "acls": [
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/a"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/b:*", "spiffe://orblx.local/node/g:*"],
    },
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/g"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/g2:*"],
    },
  ],
  "shares": [
    // SHARE-B
    {"dst": "spiffe://orblx.local/node/b:8080", "proto": "tcp", "with": ["oidc:bob"]},
  ],
}
