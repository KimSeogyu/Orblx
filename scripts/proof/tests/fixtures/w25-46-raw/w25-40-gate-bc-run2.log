head 995ea4d8b1e00b3a8eea133ad030ba442ecc334f (the #137 merge commit; Rust code unchanged)
local proof-script change for the PO release rule (19:50 KST):
 scripts/proof/ssh-renew.sh | 32 +++++++++++++++++++++++---------
 1 file changed, 23 insertions(+), 9 deletions(-)
diff --git a/scripts/proof/ssh-renew.sh b/scripts/proof/ssh-renew.sh
index 5fe839d..38eb387 100755
--- a/scripts/proof/ssh-renew.sh
+++ b/scripts/proof/ssh-renew.sh
@@ -14,14 +14,14 @@ require_root "$@"
 
 root=$(cd "$(dirname "$0")/../.." && pwd)
 cd "$root"
-bin="$root/target/debug/orblx"
+bin="$root/target/release/orblx"
 compose_file="$root/scripts/proof/compose.ssh-renew.yml"
 work=$(mktemp -d)
 env_file="$work/ssh-renew.env"
 image_dir=""
 ttl="${SSH_RENEW_TTL:-120}"
 # Gate c: the session runs this long. It opens before the first renewal of b.
-session_secs="${SSH_RENEW_SESSION_SECS:-75}"
+session_secs="${SSH_RENEW_SESSION_SECS:-110}"
 
 compose() {
   docker compose --env-file "$env_file" --progress quiet -f "$compose_file" "$@"
@@ -65,7 +65,7 @@ uname -m
 rustc --version
 
 echo "=== [C] build image ==="
-cargo build -p orblx-cli --bin orblx --locked
+cargo build --release -p orblx-cli --bin orblx --locked
 # shellcheck source=stage-image.sh
 source "$root/scripts/proof/stage-image.sh"
 image_dir="$(stage_proof_image "$root" "$bin")"
@@ -188,16 +188,22 @@ echo "=== [C] gate b: login before the first renewal ==="
 key0="$(key_b)"
 login before
 
-echo "=== [C] gate c: a session opens before the first renewal ==="
+echo "=== [C] gate c: a PTY shell session opens before the first renewal ==="
+# An exec request (--command) has a 30 s limit on the server, so gate c uses a PTY shell.
+# The input echo shows SURV""IVED. Only the shell output has SURVIVED.
 stage_login peer-session
 session_out="$work/session.out"
 session_start_renewals="$(renewals_b)"
-( ssh_b peer-session "sleep ${session_secs}; printf '%s\n' survived" >"$session_out" 2>&1
+( { printf '%s\n' "sleep ${session_secs}; echo SURV\"\"IVED at \$(date +%s); exit"; sleep $((session_secs + 30)); } \
+    | compose exec -T node-a orblx ssh alice@b --shell --identity /tmp/id \
+      --netmap /etc/orblx/netmap.json --peer-cert /tmp/peer-session.pem >"$session_out" 2>&1
   echo "exit $?" >>"$session_out" ) &
 session_pid=$!
 
 echo "=== [C] gate b: login after renewal 1 ==="
 wait_renewal 1
+renewal1_at="$(date +%s)"
+echo "renewal_1_seen_at ${renewal1_at}"
 key1="$(key_b)"
 echo "host_key_rotated_1 $([[ "$key1" != "$key0" ]] && echo yes || echo no)"
 [[ "$key1" != "$key0" ]]
@@ -208,16 +214,24 @@ if ssh_b peer-before 'true' >/dev/null 2>&1; then
 fi
 echo "denied old_host_key_1"
 
-wait "$session_pid" || true
+for _ in $(seq 1 $((session_secs + 40))); do
+  grep -q '^exit ' "$session_out" 2>/dev/null && break
+  sleep 1
+done
 session_end_renewals="$(renewals_b)"
 echo "session_renewals_b start ${session_start_renewals} end ${session_end_renewals}"
-sed 's/^/  session: /' "$session_out" | tr -d '\r'
+tr -d '\r' <"$session_out" | read_all grep -E 'SURVIVED|^exit |SSH' | sed 's/^/  session: /' || true
 (( session_end_renewals > session_start_renewals )) || {
   echo "gate_c inconclusive: the session did not span a renewal" >&2
   exit 1
 }
-if grep -qx 'survived' <(tr -d '\r' <"$session_out") && grep -qx 'exit 0' "$session_out"; then
-  echo "gate_c survived"
+survived_at="$(tr -d '\r' <"$session_out" | read_all awk '$1 == "SURVIVED" && $2 == "at" {print $3; exit}')"
+if [[ -n "$survived_at" ]] && grep -qx 'exit 0' "$session_out"; then
+  (( survived_at > renewal1_at )) || {
+    echo "gate_c inconclusive: the shell ended at ${survived_at}, before renewal 1 at ${renewal1_at}" >&2
+    exit 1
+  }
+  echo "gate_c survived shell_end ${survived_at} after renewal_1 ${renewal1_at}"
 elif grep -qx 'exit 0' "$session_out"; then
   echo "gate_c closed_cleanly_without_output"
 else
/dev/vdb        128G  104G   24G  82% /
free_space_check ok 24G
