{
  // Datapath ACL proof (W24).
  // Node a may reach node b on TCP 8080, on UDP 9000, and with ICMP.
  // Node c may reach node b only on TCP 8080. Node c has no ICMP rule.
  // No rule lets node b open a flow to node a or node c.
  // The receiving node drops each other packet in the datapath.
  "acls": [
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/a"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/b:8080"],
    },
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/a"],
      "proto": "udp",
      "dst": ["spiffe://orblx.local/node/b:9000"],
    },
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/a"],
      "proto": "icmp",
      "dst": ["spiffe://orblx.local/node/b:*"],
    },
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/c"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/b:8080"],
    },
  ],
  "tests": [
    {
      "src": "spiffe://orblx.local/node/a",
      "proto": "tcp",
      "accept": ["spiffe://orblx.local/node/b:8080"],
      "deny": ["spiffe://orblx.local/node/b:8081"],
    },
    {
      "src": "spiffe://orblx.local/node/a",
      "proto": "icmp",
      "accept": ["spiffe://orblx.local/node/b:*"],
    },
    {
      "src": "spiffe://orblx.local/node/c",
      "proto": "icmp",
      "deny": ["spiffe://orblx.local/node/b:*"],
    },
  ],
}
