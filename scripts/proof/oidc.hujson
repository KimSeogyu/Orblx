{
  // The OIDC laptop may send UDP to node srv.
  // W25-15: the test users are owner users, so they do not wait for approval.
  "userApproval": {
    "ownerUsers": ["oidc:alice", "oidc:bob", "oidc:dave"],
  },
  "acls": [
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/laptop"],
      "proto": "udp",
      "dst": ["spiffe://orblx.local/node/srv:*"]
    },
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/laptop"],
      "proto": "icmp",
      "dst": ["spiffe://orblx.local/node/srv:*"]
    }
  ]
}
