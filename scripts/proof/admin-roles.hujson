{
  // Admin role proof. nodeApproval is on. oidc:olivia is an owner user.
  "nodeApproval": true,
  "owners": ["spiffe://orblx.local/node/owner"],
  "userApproval": {
    "ownerUsers": ["oidc:olivia"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/owner"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/owner:*"]
    }
  ]
}
