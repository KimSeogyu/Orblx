{
  // Revoke-all proof (W24-D).
  // Node a is the principal that the owner revokes. Node c is the other principal.
  // Both may reach node b on all TCP ports: the agent guard (8080),
  // SSH (22), and the file receiver (4243).
  "nodeApproval": true,
  "owners": ["spiffe://orblx.local/node/owner"],
  "acls": [
    {
      "action": "accept",
      "src": ["spiffe://orblx.local/node/a", "spiffe://orblx.local/node/c"],
      "proto": "tcp",
      "dst": ["spiffe://orblx.local/node/b:*"],
    },
  ],
  "ssh": [
    {
      "src": ["spiffe://orblx.local/node/a", "spiffe://orblx.local/node/c"],
      "dst": ["spiffe://orblx.local/node/b"],
      "users": ["root"],
      "checkPeriod": "30s",
    },
  ],
}
