{
  // W25-10 HA subnet routers proof.
  // router-a and router-b may both publish 10.88.125.0/24 (routeApprovals).
  // Gate 1 starts with a copy of this file that approves only router-a.
  // The client may reach the target 10.88.125.5 on UDP 9000, TCP 8080, TCP 8090, and ICMP,
  // and the nameserver 10.88.125.53 on UDP 53. Gate 4 removes the UDP 53 rule.
  // The guest has no rule. Each router drops the guest packets and the other client ports.
  "groups": {
    "group:humans": ["spiffe://orblx.local/node/client"],
  },
  "acls": [
    {
      "action": "accept",
      "src": ["group:humans"],
      "proto": "udp",
      "dst": ["10.88.125.5/32:9000"],
    },
    {
      "action": "accept",
      "src": ["group:humans"],
      "proto": "tcp",
      "dst": ["10.88.125.5/32:8080", "10.88.125.5/32:8090"],
    },
    {
      "action": "accept",
      "src": ["group:humans"],
      "proto": "icmp",
      "dst": ["10.88.125.5/32:*"],
    },
    {
      "action": "accept",
      "src": ["group:humans"],
      "proto": "udp",
      "dst": ["10.88.125.53/32:53"],
    },
  ],
  "routeApprovals": [
    {
      "src": [
        "spiffe://orblx.local/node/router-a",
        "spiffe://orblx.local/node/router-b",
      ],
      "routes": ["10.88.125.0/24"],
    },
  ],
  "tests": [
    {
      "src": "spiffe://orblx.local/node/client",
      "proto": "tcp",
      "deny": ["spiffe://orblx.local/node/router-a:22", "spiffe://orblx.local/node/router-b:22"],
    },
  ],
}
