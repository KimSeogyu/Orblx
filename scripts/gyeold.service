[Unit]
Description=Gyeol node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gyeol up --netmap /etc/gyeol/netmap.json --state-dir /var/lib/gyeol
ExecStop=/usr/local/bin/gyeol down --state-dir /var/lib/gyeol
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StateDirectory=gyeol
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
